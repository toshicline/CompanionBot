<robot xmlns:xacro="http://ros.org" name="rplidar_s2">
    
    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="-1.57 0 3.1415"/>
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/rplidar_s2.dae"/>
            </geometry>
        </visual>

         <collision>
            <origin xyz="0 0 0" rpy="-1.57 0 3.1415"/>
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/rplidar_s2.dae"/>
            </geometry>
        </collision> 

        <!--
        <collision>
           
            <origin xyz="0 0 -0.02" rpy="0 0 0"/> 
            <geometry>
                <cylinder radius="0.04" length="0.04"/>
            </geometry>
        </collision> -->

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.19"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="lidar_to_payload" type="fixed">
        <parent link="payload_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.174 0 0.145" rpy="0 0 3.1415"/>
        <!-- above used to be 0.174 0 0.145 -->
    </joint>

    <gazebo reference="lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <!-- Changed from ignition_frame_id to gz_frame_id -->
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10</update_rate>
            <!-- used to be 10 -->
            <lidar>
                <scan>
                <horizontal>
                    <samples>640</samples>
                    <!-- used to be 640 -->
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>0.0</max_angle>
                </vertical>
                </scan>
                <range>
                <min>0.15</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
                </range>
            </lidar>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <gazebo>    
        <!-- Updated filename, name, and shifted back to ogre2 for Gazebo Harmonic -->
        <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

</robot>
